ANTHROPIC_API_KEY=sk-ant-...
# optional: only used by `python data/build_places.py --run` (one-time provider build).
# Chat, tests and evals never call Google, even when this is set.
GOOGLE_MAPS_API_KEY=
# hard monthly limit on billable Places calls (Google's free tier is 1,000/month)
NLA_PLACES_MONTHLY_CAP=800
# optional model overrides
NLA_MODEL=claude-sonnet-5-5
NLA_SIM_MODEL=claude-haiku-5-5
NLA_JUDGE_MODEL=claude-haiku-5-5
